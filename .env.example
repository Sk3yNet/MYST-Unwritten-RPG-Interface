# Environment variables for the Portainer stack (Stacks ▸ your stack ▸ Environment variables).
# Copy the names; never commit real values.

PUBLIC_HOST=unwritten.yourdomain.com
CF_TUNNEL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_COOKIE_SECRET=
TZ=America/New_York

# --- optional: who may do what ---------------------------------------------------------------
# Who may start campaigns. Empty = anyone who signs in. Comma-separated, no spaces.
GM_EMAILS=you@gmail.com
# Who may sign in at all. Leave both empty to let any Google account in (they still need an invite link to see a table).
# ALLOWED_EMAIL=you@gmail.com,friend@gmail.com
# ALLOWED_DOMAINS=example.com
